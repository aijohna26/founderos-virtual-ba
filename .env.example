# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Billing webhook (Dashboard -> Webhooks -> add endpoint -> /api/webhooks/clerk).
# Subscribe to: subscription.created, subscription.updated, subscription.active,
# subscription.pastDue, subscriptionItem.canceled, subscriptionItem.pastDue.
# Must be the Signing Secret Clerk shows for that specific endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase. The sb_secret_ key is server-only and must never use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Gemini. Keep this server-only.
GEMINI_API_KEY=

# Venture invitations. Use a random secret of at least 32 characters and a
# Resend sender on a verified domain (for example FounderAlly <team@example.com>).
INVITE_TOKEN_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=http://localhost:3001

# Optional UI flags
SHOW_ADVANCED_FEATURES=false
NEXT_PUBLIC_SHOW_ADVANCED_FEATURES=false
